{
  "editor.formatOnSave": true,
  "git.allowForcePush": true,
  "git.autofetch": "all",
  "git.autoStash": true,
  "git.pruneOnFetch": true,
  "git.rebaseWhenSync": true,
  "git.suggestSmartCommit": false,
  "git.supportCancellation": true,
  "git.useEditorAsCommitInput": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "git.useForcePushIfIncludes": false,
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "files.autoSave": "onFocusChange",
  "search.useIgnoreFiles": true,
  "git.useCommitInputAsStashMessage": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always"
  },
  "files.eol": "\n",
  "python.testing.pytestEnabled": true,
  "testing.automaticallyOpenPeekView": "never",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[markdown]": {
    "editor.defaultFormatter": "Jota0222.multi-formatter",
    // dprint has a ruff plugin, but we use ruff instead so we dont need 2 separate installations of ruff.
    "multiFormatter.formatterList": ["dprint.dprint", "charliermarsh.ruff"],
    "editor.formatOnSave": true
  },
  // why does vscode treat github actions yaml files as a separate language????
  "[toml][json][jsonc][yaml][markdown][github-actions-workflow][html]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "explorer.compactFolders": false,
  "search.exclude": {
    "pw": true
  },
  "python.terminal.activateEnvInCurrentTerminal": true,
  "debugpy.debugJustMyCode": false,
  "terminal.integrated.env.windows": {
    "PATH": "${env:PATH};${workspaceFolder}/.pyprojectx/main"
  },
  "terminal.integrated.env.osx": {
    "PATH": "${env:PATH}:${workspaceFolder}/.pyprojectx/main"
  },
  "terminal.integrated.env.linux": {
    "PATH": "${env:PATH}:${workspaceFolder}/.pyprojectx/main"
  },
  "task.problemMatchers.neverPrompt": true,
  "editor.suggest.showWords": false,
  "files.readonlyInclude": {
    ".pyprojectx/**/*": true,
    ".pytest_cache/**/*": true,
    ".venv/**/*": true,
    "**/dist/**/*": true,
    "uv.lock": true,
    "pw.lock": true,
    "pw": true,
    "pw.bat": true
  },
  "chat.disableAIFeatures": true,
  "git.blame.editorDecoration.enabled": true,
  "json.schemaDownload.trustedDomains": {
    "https://plugins.dprint.dev": true
  }
}
